# Anjam Production Environment Configuration
# Copy this file to .env and configure for your deployment

# =============================================================================
# ORGANIZATION MODE (Build-time)
# =============================================================================

# Organization mode: "product" (default) or "operations"
# This is a BUILD-TIME setting - all organizations in this deployment will use this mode.
# Set via environment variable at build time:
#   - VITE_ORG_MODE=product (for product/kanban mode - Linear-like experience)
#   - VITE_ORG_MODE=operations (for operations/task management mode)
VITE_ORG_MODE=product

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Disable default account creation after initial setup
# Set to 'true' only during first deployment to create initial admin
TM_ALLOW_DEFAULT_ACCOUNTS=false

# Settings encryption key (32-character hex string)
# Generate with: openssl rand -hex 16
# IMPORTANT: Keep this key safe - losing it means losing access to encrypted settings
ANJAM_ENCRYPTION_KEY=

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# Go memory limit for garbage collector optimization
# Recommended: 50-75% of container memory limit
# Examples: 256MiB, 512MiB, 1GiB
GOMEMLIMIT=512MiB

# =============================================================================
# TIMEZONE
# =============================================================================

# Application timezone
TZ=Asia/Tehran

# =============================================================================
# RATE LIMITING
# =============================================================================

# Enable built-in rate limiter (highly recommended for production)
PB_RATE_LIMIT_ENABLED=true

# =============================================================================
# TRUSTED PROXY (Required when behind nginx/Caddy/etc)
# =============================================================================

# Comma-separated list of trusted proxy headers
PB_TRUSTED_PROXY_HEADERS=X-Forwarded-For,X-Real-IP

# Use leftmost IP from X-Forwarded-For chain (recommended)
PB_TRUSTED_PROXY_USE_LEFTMOST=true

# =============================================================================
# SMTP CONFIGURATION (Required for password resets, MFA codes)
# =============================================================================

# SMTP server hostname (leave empty to disable email)
SMTP_HOST=

# SMTP server port (587 for TLS, 465 for SSL, 25 for unencrypted)
SMTP_PORT=587

# SMTP authentication credentials
SMTP_USERNAME=
SMTP_PASSWORD=

# Enforce TLS encryption
SMTP_TLS=true

# Authentication method: PLAIN or LOGIN
SMTP_AUTH_METHOD=PLAIN

# Optional: Domain for EHLO/HELO exchange
SMTP_LOCAL_NAME=

# Sender information for transactional emails
SMTP_SENDER_NAME=Anjam
SMTP_SENDER_ADDRESS=noreply@example.com

# =============================================================================
# LOGGING
# =============================================================================

# Log retention in days (0 = disabled)
PB_LOGS_MAX_DAYS=30

# Minimum log level: -4=DEBUG, 0=INFO, 4=WARN, 8=ERROR
PB_LOGS_MIN_LEVEL=0

# Log client IP addresses (useful for debugging)
PB_LOGS_LOG_IP=true

# Log authenticated user IDs
PB_LOGS_LOG_AUTH_ID=true

# =============================================================================
# BATCH API OPERATIONS
# =============================================================================

# Enable batch Web APIs
PB_BATCH_ENABLED=true

# Maximum requests per batch transaction
PB_BATCH_MAX_REQUESTS=50

# Batch operation timeout in seconds
PB_BATCH_TIMEOUT=30

# Maximum request body size in bytes (default: 5MB)
PB_BATCH_MAX_BODY_SIZE=5242880



VITE_PUBLIC_POSTHOG_KEY=REDACTED_POSTHOG_KEY
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
