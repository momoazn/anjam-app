# Convex Deployment Configuration
# Copy this file to .env and configure for your deployment

# =============================================================================
# CONVEX CONFIGURATION
# =============================================================================

# Your Convex deployment URL (or leave empty for local development)
# Get this from https://dashboard.convex.dev after creating a deployment
CONVEX_DEPLOYMENT=

# =============================================================================
# EMAIL CONFIGURATION (Resend)
# =============================================================================

# Resend API key for transactional emails (password reset, verification, etc.)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# Sender email address for transactional emails
AUTH_RESEND_FROM=noreply@example.com

# =============================================================================
# ANALYTICS (PostHog)
# =============================================================================

# PostHog public key for analytics (optional)
VITE_PUBLIC_POSTHOG_KEY=

# PostHog host URL
VITE_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# TIMEZONE
# =============================================================================

# Application timezone
TZ=Asia/Tehran
