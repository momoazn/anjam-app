# Anjam Production Environment Configuration
# Copy this file to .env and configure for your deployment

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Disable default account creation after initial setup
# Set to 'true' only during first deployment to create initial admin
TM_ALLOW_DEFAULT_ACCOUNTS=false

# Settings encryption key (32-character hex string)
# Generate with: openssl rand -hex 16
# IMPORTANT: Keep this key safe - losing it means losing access to encrypted settings
ANJAM_ENCRYPTION_KEY=

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# Go memory limit for garbage collector optimization
# Recommended: 50-75% of container memory limit
# Examples: 256MiB, 512MiB, 1GiB
GOMEMLIMIT=512MiB

# =============================================================================
# TIMEZONE
# =============================================================================

# Application timezone
TZ=Asia/Tehran

# =============================================================================
# DOCKER DEPLOYMENT (used by docker-compose)
# =============================================================================

# Host port to expose the application
# Default: 8090
# HOST_PORT=8090

# Container memory limit
# Default: 1G
# MEMORY_LIMIT=1G
