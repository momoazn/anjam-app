# Convex Deployment Configuration
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Better Auth rate limiting (optional; enabled by default in production)
# AUTH_RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# AUTH_RATE_LIMIT_MAX=120
# AUTH_SIGNIN_RATE_LIMIT_WINDOW_SECONDS=900
# AUTH_SIGNIN_RATE_LIMIT_MAX=5
# AUTH_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600
# AUTH_SIGNUP_RATE_LIMIT_MAX=10

# Email (Resend)
RESEND_API_KEY=
AUTH_RESEND_FROM=noreply@example.com

# Analytics (PostHog - optional)
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Timezone
TZ=Asia/Tehran
