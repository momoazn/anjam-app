{
  "name": "task-manager-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "web:lint": "eslint .",
    "web:lint:fix": "eslint . --fix",
    "web:format": "prettier --write .",
    "web:format:check": "prettier --check .",
    "web:check": "bun run web:type-check && bun run web:lint && bun run web:format:check",
    "web:type-check": "tsc --noEmit",
    "web:fix": "bun run web:lint:fix && bun run web:format",
    "api:dev": "air",
    "api:serve": "go run main.go",
    "api:build": "go build -o task-manager main.go",
    "api:build:win": "GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go build -ldflags=\"-s -w\" -o task-manager.exe main.go",
    "api:typegen": "pocketbase-typegen --json ./pb_schema.json --out src/lib/pocketbase-types.ts",
    "seed:generate": "bun run scripts/generate-data.ts",
    "seed:run": "bun run scripts/seed-data.ts",
    "seed:truncate": "bun run scripts/truncate.ts",
    "seed:reset": "bun run seed:truncate && bun run seed:run",
    "dev": "concurrently \"bun run web:dev\" \"bun run api:dev\" -n \"WEB,API\"",
    "start": "bun run api:serve",
    "build": "bun run web:build && bun run api:build",
    "build:win": "bun run web:build && bun run api:build:win",
    "build:ui": "bun run web:build",
    "build:api": "bun run api:build",
    "clean": "rm -rf dist && rm -rf node_modules && rm -rf tmp && rm -rf task-manager"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@faker-js/faker": "^9.6.0",
    "@hookform/resolvers": "^5.0.1",
    "@persian-tools/persian-tools": "^3.6.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tabler/icons-react": "^3.31.0",
    "@tailwindcss/vite": "^4.1.3",
    "@tanstack/react-query": "^5.72.2",
    "@tanstack/react-table": "^8.21.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-jalali": "4.1.0-0",
    "lucide-react": "^0.487.0",
    "next-themes": "^0.4.6",
    "pocketbase": "^0.25.2",
    "react": "^19.0.0",
    "react-day-picker": "9.6.7",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "react-router-dom": "^7.5.0",
    "recharts": "^2.15.2",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.3",
    "tw-animate-css": "^1.2.5",
    "vaul": "^1.1.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/bun": "^1.2.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "pocketbase-typegen": "^1.3.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "terser": "^5.39.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
