{
  "name": "task-manager-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "bun run build:client && bun run build:server",
    "build:win": "bun run build:client && bun run build:server:win",
    "build:client": "vite build",
    "build:server": "go build -o task-manager main.go",
    "build:server:win": "GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go build -ldflags=\"-s -w\" -o task-manager.exe main.go",
    "dev": "concurrently \"bun run dev:client\" \"bun run dev:server\" -n \"WEB,API\"",
    "dev:client": "vite",
    "dev:server": "air",
    "fmt:check": "prettier --check .",
    "fmt:fix": "prettier --write .",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "type:check": "tsc --noEmit",
    "check": "bun run type:check && bun run lint:check && bun run fmt:check",
    "fix": "bun run lint:fix && bun run fmt:fix",
    "clean": "rm -rf dist && rm -rf node_modules && rm -rf tmp && rm -rf task-manager",
    "seed:generate": "bun run scripts/generate-data.ts",
    "seed:truncate": "bun run scripts/truncate.ts",
    "seed:insert": "bun run scripts/seed-data.ts",
    "seed": "bun run seed:truncate && bun run seed:insert",
    "gen:type": "pocketbase-typegen --json ./pb_schema.json --out src/lib/pocketbase-types.ts",
    "serve:client": "vite preview",
    "serve:server": "go run main.go"
  },
  "dependencies": {
    "@faker-js/faker": "^9.6.0",
    "@hookform/resolvers": "^5.0.1",
    "@persian-tools/persian-tools": "^3.6.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tabler/icons-react": "^3.31.0",
    "@tailwindcss/vite": "^4.1.3",
    "@tanstack/react-query": "^5.72.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-jalali": "4.1.0-0",
    "lucide-react": "^0.487.0",
    "next-themes": "^0.4.6",
    "pocketbase": "^0.25.2",
    "react": "^19.0.0",
    "react-day-picker": "9.6.7",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "react-router-dom": "^7.5.0",
    "recharts": "^2.15.2",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.3",
    "tw-animate-css": "^1.2.5",
    "use-debounce": "^10.0.6",
    "vaul": "^1.1.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/bun": "^1.2.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "pocketbase-typegen": "^1.3.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "terser": "^5.39.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
