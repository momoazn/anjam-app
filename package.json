{
  "name": "task-manager-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\" -n \"SERVER,CLIENT\"",
    "dev:full": "concurrently \"bun run dev:server\" \"bun run dev:client\" -n \"SERVER,CLIENT\"",
    "dev:client": "bun x --bun vite",
    "dev:server": "air",
    "build": "bun run scripts/build.ts --current-platform",
    "build:client": "bun x --bun vite build",
    "build:server": "bun run scripts/build.ts --skip-client --current-platform",
    "build:linux": "bun run scripts/build.ts --skip-client --skip-windows --skip-mac",
    "build:windows": "bun run scripts/build.ts --skip-client --skip-linux --skip-mac",
    "build:mac": "bun run scripts/build.ts --skip-client --skip-linux --skip-windows",
    "build:run": "bun run scripts/build.ts --current-platform --run",
    "start": "bun run scripts/start.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "bun run test:run && bun run test:e2e",
    "lint": "bun x --bun eslint .",
    "lint:fix": "bun x --bun eslint . --fix",
    "format": "bun x --bun prettier --check .",
    "format:fix": "bun x --bun prettier --write .",
    "type:check": "bun x --bun tsc -p tsconfig.app.json --noEmit && bun x --bun tsc -p tsconfig.node.json --noEmit",
    "check": "bun run type:check && bun run lint && bun run format",
    "fix": "bun run lint:fix && bun run format:fix",
    "data:generate": "bun run scripts/generate-data.ts",
    "data:truncate": "bun run scripts/truncate.ts",
    "data:seed": "bun run scripts/seed-data.ts",
    "data:reset": "bun run data:truncate && bun run data:seed",
    "types:generate": "pocketbase-typegen --json ./backend/pb_schema.json --out src/lib/pocketbase-types.ts",
    "clean": "rm -rf backend/dist node_modules tmp task-manager release",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@faker-js/faker": "^9.9.0",
    "@hookform/resolvers": "^5.2.2",
    "@persian-tools/persian-tools": "^3.6.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tabler/icons-react": "^3.36.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-jalali": "4.1.0-0",
    "lucide-react": "^0.487.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.5",
    "pocketbase": "^0.25.2",
    "react": "^19.2.3",
    "react-day-picker": "9.6.7",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.68.0",
    "react-router-dom": "^7.11.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.0.6",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.4",
    "@types/node": "^22.19.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.0.16",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "pocketbase-typegen": "^1.3.2",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "terser": "^5.44.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "bun x --bun prettier --write --cache --cache-location .cache/prettier",
      "bun x --bun eslint --fix --cache --cache-location .cache/eslint"
    ],
    "*.{json,md,yml,yaml}": [
      "bun x --bun prettier --write --cache --cache-location .cache/prettier"
    ]
  }
}
