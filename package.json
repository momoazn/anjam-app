{
  "name": "anjam-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\" -n \"SERVER,CLIENT\"",
    "dev:full": "concurrently \"bun run dev:server\" \"bun run dev:client\" -n \"SERVER,CLIENT\"",
    "dev:client": "bun x --bun vite --host",
    "dev:server": "air",
    "build": "bun run scripts/build.ts --current-platform",
    "build:client": "bun x --bun vite build",
    "build:analyze": "ANALYZE=true bun x --bun vite build",
    "build:server": "bun run scripts/build.ts --skip-client --current-platform",
    "build:linux": "bun run scripts/build.ts --skip-client --skip-windows --skip-mac",
    "build:windows": "bun run scripts/build.ts --skip-client --skip-linux --skip-mac",
    "build:mac": "bun run scripts/build.ts --skip-client --skip-linux --skip-windows",
    "build:run": "bun run scripts/build.ts --current-platform --run",
    "build:legacy": "bun run scripts/build.ts --legacy-names",
    "start": "bun run scripts/start.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "bun run test:run && bun run test:e2e",
    "lint": "bun x --bun eslint .",
    "lint:fix": "bun x --bun eslint . --fix",
    "format": "bun x --bun prettier --check .",
    "format:fix": "bun x --bun prettier --write .",
    "type:check": "bun x --bun tsc -p tsconfig.app.json --noEmit --incremental && bun x --bun tsc -p tsconfig.node.json --noEmit --incremental",
    "check": "bun run type:check && bun run lint && bun run format",
    "fix": "bun run lint:fix && bun run format:fix",
    "setup": "bun run scripts/setup.ts",
    "data:seed": "bun run scripts/seed-data.ts",
    "data:reset": "bun run setup",
    "types:generate": "pocketbase-typegen --json ./backend/pb_schema.json --out src/lib/pocketbase-types.ts",
    "clean": "rm -rf backend/dist node_modules tmp release",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@persian-tools/persian-tools": "^4.0.4",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tabler/icons-react": "^3.36.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-jalali": "4.1.0-0",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.1.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.6",
    "pocketbase": "^0.26.5",
    "posthog-js": "^1.310.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.69.0",
    "react-resizable-panels": "^4.0.15",
    "react-router-dom": "^7.11.0",
    "recharts": "3.6.0",
    "shadcn": "^3.6.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.0.6",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^4.0.16",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "pocketbase-typegen": "^1.3.2",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "terser": "^5.44.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "bun x --bun prettier --write --cache --cache-location .cache/prettier",
      "bun x --bun eslint --fix --cache --cache-location .cache/eslint"
    ],
    "*.{json,md,yml,yaml}": [
      "bun x --bun prettier --write --cache --cache-location .cache/prettier"
    ]
  }
}
