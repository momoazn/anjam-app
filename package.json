{
  "name": "task-manager-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "lint": "bunx --bun eslint .",
    "preview": "bunx --bun vite preview",
    "format": "bunx --bun prettier --write .",
    "pb:dev": "air",
    "pb:serve": "go run main.go",
    "pb:build": "go build -o task-manager main.go",
    "pb:build:win": "go build -o task-manager.exe main.go",
    "pb:typegen": "bunx --bun pocketbase-typegen --db ./pb_data/data.db --out src/lib/pocketbase-types.ts",
    "pb:data": "bun run scripts/generate-data.ts",
    "pb:seed": "bun run scripts/seed-data.ts",
    "pb:truncate": "bun run scripts/truncate.ts",
    "dev:all": "concurrently \"bun run dev\" \"bun run pb:dev\" -n \"Dev Server,PocketBase Server\"",
    "build:all": "bun run build && bun run pb:build",
    "build:all:win": "bun run build && bun run pb:build:win"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@faker-js/faker": "^9.6.0",
    "@hookform/resolvers": "^5.0.1",
    "@persian-tools/persian-tools": "^3.6.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tabler/icons-react": "^3.31.0",
    "@tailwindcss/vite": "^4.1.3",
    "@tanstack/react-query": "^5.72.2",
    "@tanstack/react-table": "^8.21.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-jalali": "4.1.0-0",
    "lucide-react": "^0.487.0",
    "next-themes": "^0.4.6",
    "pocketbase": "^0.25.2",
    "react": "^19.0.0",
    "react-day-picker": "9.6.7",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "react-router-dom": "^7.5.0",
    "recharts": "^2.15.2",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.3",
    "tw-animate-css": "^1.2.5",
    "vaul": "^1.1.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/bun": "^1.2.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "terser": "^5.39.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
